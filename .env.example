# Ambiente local do Docker Compose.
#
# Copie para `.env` na raiz antes de subir o ambiente:
#
#     cp .env.example .env
#
# Este arquivo e a unica fonte das variaveis que o Compose interpola. Ele nao e
# lido pela aplicacao PHP diretamente: o Compose injeta os valores no ambiente
# de cada container, e e de la que o framework os le.
#
# Todos os valores abaixo sao locais e ficticios, servem apenas ao ambiente de
# desenvolvimento e avaliacao desta maquina, e nao dao acesso a nada fora dela.
# Em qualquer outro ambiente eles precisam ser substituidos por valores gerados
# especificamente para ele.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Credencial administrativa do servidor MySQL. Usada apenas pela inicializacao
# da imagem e pela verificacao de saude do proprio container; nem a aplicacao
# nem a preparacao se conectam com ela.
DB_ROOT_PASSWORD=raiz_local_apenas

# Schema da aplicacao.
DB_DATABASE=video_platform

# Schema da suite de testes. Precisa ser diferente de DB_DATABASE: a suite
# limpa o proprio schema entre execucoes, e apontar os dois para o mesmo nome
# apagaria os dados preparados para a avaliacao. A inicializacao do banco
# recusa a subida quando os dois nomes coincidem.
DB_TEST_DATABASE=video_platform_testes

# Usuario da aplicacao, com privilegio sobre os dois schemas acima.
DB_USERNAME=video_platform
DB_PASSWORD=senha_local_apenas

# ---------------------------------------------------------------------------
# Storage de objetos
# ---------------------------------------------------------------------------

# Os dois enderecos sao variaveis separadas de proposito (plan §16.3).
#
# O interno atende as chamadas feitas de dentro da rede do Compose — criar o
# bucket, conferir o objeto enviado, assinar. O publico e o host que aparece
# nas URLs pre-assinadas entregues ao navegador. Trocar um pelo outro produz
# URL que a API considera valida e o navegador nao alcanca.
STORAGE_ENDPOINT_INTERNAL=http://rustfs:9000
STORAGE_ENDPOINT_PUBLIC=http://localhost:19000

# Credenciais do storage local. O mesmo par configura o servidor e assina as
# requisicoes do cliente, entao nao ha como os dois divergirem.
STORAGE_ACCESS_KEY=chave_local_apenas
STORAGE_SECRET_KEY=segredo_local_apenas

# Regiao declarada na assinatura. O storage local nao tem regiao de verdade,
# mas o protocolo exige uma, e ela precisa ser a mesma dos dois lados.
STORAGE_REGION=us-east-1

# Bucket dos videos enviados. Criado pela preparacao do ambiente, se ainda nao
# existir.
STORAGE_BUCKET=video-platform

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------

# Endereco publico da API: o que o navegador alcanca, e nao o nome do servico na
# rede interna. Serve tanto ao backend, ao montar link absoluto, quanto ao
# frontend, como base das chamadas HTTP.
APP_URL=http://localhost:8080

# Chave de criptografia da aplicacao.
#
# **Deixe vazia.** Ela e gerada automaticamente na primeira subida do ambiente,
# dentro da imagem do backend, e gravada no seu `.env` — que nao vai para o Git.
# Uma chave publicada aqui seria a mesma em toda copia do repositorio, e assinar
# sessao com um segredo que todos conhecem equivale a nao assinar.
#
# Uma vez preenchida, ela nunca e substituida: trocar a chave invalidaria as
# sessoes ativas e tudo o que tiver sido cifrado com ela.
APP_KEY=

# Origem do frontend, em duas variaveis com papeis diferentes (plan §9.2).
#
# A primeira diz ao Sanctum quais hosts sao first-party e devem autenticar por
# sessao; usa host e porta, sem esquema. A segunda autoriza o navegador a ler as
# respostas e usa a origem completa, com esquema e porta. Trata-las como a mesma
# lista e a causa mais comum de sessao que nao persiste.
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie da sessao.
#
# Os valores abaixo descrevem o ambiente local, que roda em HTTP puro. Numa
# publicacao sob HTTPS, `SESSION_SECURE_COOKIE` precisa passar a `true` — sem
# isso a credencial viajaria em texto claro.
#
# `SESSION_DOMAIN=null` deixa o cookie host-only: o navegador o devolve apenas ao
# host que o emitiu, sem alcancar subdominios. Cookies nao sao separados por
# porta, entao o mesmo cookie de `localhost` serve ao frontend em :3000 e a API
# em :8080.
#
# `HTTP_ONLY` mantem a credencial fora do alcance do JavaScript, e `lax` faz o
# cookie acompanhar a navegacao normal sem viajar em requisicao partida de outro
# site — que e o vetor do CSRF.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Segredo compartilhado da assinatura do callback de processamento (plan §13.4).
# Quem assina e quem confere sao processos distintos deste mesmo ambiente, entao
# o valor precisa ser unico. Gere o seu com qualquer fonte de aleatoriedade; o
# valor abaixo e ficticio e existe so para o ambiente subir.
WEBHOOK_SECRET=segredo_de_webhook_local_apenas

# Endereco do callback dentro da rede do Compose. O simulador chama daqui, de
# dentro de um container, e o endereco publico dependeria do encaminhamento de
# porta do host. Basta alterar se o servico HTTP mudar de nome.
WEBHOOK_CALLBACK_URL=http://web/api/webhooks/video-processing
