# Configuracao da aplicacao Laravel.
#
# No ambiente containerizado este arquivo nao precisa ser copiado: o Compose
# injeta os valores no ambiente de cada container, e o carregador do framework e
# imutavel — uma variavel que ja existe no processo nunca e sobrescrita por
# arquivo. A fonte dos valores, la, e o `.env` da raiz do repositorio.
#
# Ele existe por dois motivos: documentar a superficie de configuracao que a
# aplicacao le, e permitir executar o backend fora do Compose. Nesse caso, copie
# para `backend/.env` e ajuste os enderecos — de dentro da rede do Compose os
# servicos se alcancam pelo nome, de fora, apenas pelas portas publicadas em
# 127.0.0.1.
#
# Todos os valores sao locais e ficticios. Nenhum deles da acesso a coisa alguma
# fora desta maquina.

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------

APP_NAME="Plataforma de Video"
APP_ENV=local

# Chave de criptografia da aplicacao.
#
# E o que permite ao framework cifrar e assinar valores, inclusive os cookies da
# autenticacao. Todos os containers PHP recebem a mesma chave porque executam a
# mesma aplicacao e precisam de configuracao criptografica coerente — nao porque
# a preparacao e os consumidores leiam a sessao do navegador, o que nao ocorre.
#
# Fica vazia aqui de proposito: uma chave publicada em arquivo versionado nao e
# chave. A subida do ambiente gera a sua automaticamente, dentro da imagem do
# backend, e grava no `.env` da raiz — que o Git ignora. Chave ja preenchida
# nunca e substituida.
APP_KEY=

APP_DEBUG=true

# Endereco publico da API — o mesmo que o navegador usa.
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Custo do algoritmo de hash das senhas.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------

# Saida de erro do processo, e nao arquivo. Em container e a saida que
# `docker compose logs` mostra; fora dele, o terminal. Escrever em arquivo
# exigiria permissao de escrita na arvore da aplicacao, que o processo nao tem.
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

DB_CONNECTION=mysql

# Nome do servico na rede do Compose. Fora dela, o banco nao esta publicado no
# host: para executar o backend de fora, publique a porta ou use um tunel.
DB_HOST=mysql
DB_PORT=3306

DB_DATABASE=video_platform
DB_USERNAME=video_platform
DB_PASSWORD=senha_local_apenas

# Charset e collation da conexao e de cada tabela criada. O framework nao herda
# o padrao do servidor: declara os proprios valores. Configurar so o MySQL
# deixaria as tabelas na collation padrao do framework, divergente da
# arquitetura (plan §7).
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# ---------------------------------------------------------------------------
# Sessao, cache e fila
# ---------------------------------------------------------------------------

# Sessao em banco, e nao em arquivo. Quem participa da sessao do navegador e a
# API, e guardar o registro no MySQL o mantem fora do sistema de arquivos
# efemero do container: recriar o container nao desloga ninguem (plan §9).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Sem dominio: o cookie e host-only e volta apenas ao host que o emitiu. Cookies
# nao sao separados por porta, entao o mesmo cookie de `localhost` serve ao
# frontend em :3000 e a API em :8080.
SESSION_DOMAIN=null

# HTTP local. Marcar o cookie como seguro faria o navegador descarta-lo, e a
# sessao nunca persistiria.
SESSION_SECURE_COOKIE=false

# A credencial de autenticacao fica fora do alcance do JavaScript.
SESSION_HTTP_ONLY=true

# Acompanha o fluxo first-party e nao viaja em requisicao partida de outro site.
SESSION_SAME_SITE=lax

# Hosts first-party do Sanctum: host e porta, sem esquema. Origens autorizadas
# pelo CORS: origem completa, com esquema e porta. Sao listas diferentes, com
# formatos diferentes, e confundi-las quebra a sessao (plan §9.2).
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

CACHE_STORE=database

# Fila persistida no proprio MySQL (plan §13.1). Sem broker dedicado: o volume
# deste problema nao justifica um componente a mais no ambiente.
QUEUE_CONNECTION=database

# Janela de reserva de um job, em segundos. Precisa ser maior que o tempo limite
# de execucao configurado nos consumidores — 60 segundos —, senao a fila
# devolveria o job antes de o processo desistir dele e o mesmo trabalho rodaria
# duas vezes em paralelo.
DB_QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Storage de objetos
# ---------------------------------------------------------------------------

# Os dois enderecos sao separados de proposito (plan §16.3): o interno atende as
# chamadas feitas de dentro da rede, e o publico e o host que aparece nas URLs
# pre-assinadas entregues ao navegador.
#
# Os valores abaixo sao os de uma execucao de fora do Compose, em que os dois
# coincidem na porta publicada. Dentro da rede, o interno e `http://rustfs:9000`.
STORAGE_ENDPOINT_INTERNAL=http://localhost:19000
STORAGE_ENDPOINT_PUBLIC=http://localhost:19000

STORAGE_ACCESS_KEY=chave_local_apenas
STORAGE_SECRET_KEY=segredo_local_apenas
STORAGE_REGION=us-east-1
STORAGE_BUCKET=video-platform

# ---------------------------------------------------------------------------
# Callback de processamento
# ---------------------------------------------------------------------------

# Segredo compartilhado da assinatura HMAC do callback (plan §13.4). Quem assina
# e quem confere sao processos distintos do mesmo ambiente, entao o valor
# precisa ser unico. O valor abaixo e ficticio e serve so ao ambiente local.
WEBHOOK_SECRET=segredo_de_webhook_local_apenas

# Endereco do callback usado pelo simulador. Dentro da rede do Compose e
# `http://web/api/webhooks/video-processing`; fora dela, o endereco publico da
# API.
WEBHOOK_CALLBACK_URL=http://localhost:8080/api/webhooks/video-processing
