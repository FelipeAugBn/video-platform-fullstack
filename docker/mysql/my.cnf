# Configuracao do servidor MySQL do ambiente local.
#
# Montada em /etc/mysql/conf.d/, diretorio que o /etc/my.cnf da imagem oficial
# inclui ao final — o que estiver aqui prevalece sobre os defaults dela.
#
# Somente o que o projeto precisa declarar de forma explicita. Sem ajuste de
# performance: o volume de dados da avaliacao nao justifica, e parametro
# calibrado no escuro atrapalha mais do que ajuda.

[mysqld]

# Motor transacional, exigido pelo plano (plan §7). E o padrao no MySQL 8, mas
# fica explicito: o comportamento transacional e a integridade referencial sao
# premissa do dominio, nao detalhe herdado.
default-storage-engine=InnoDB

# utf8mb4 e o unico charset do MySQL que cobre o UTF-8 completo, incluindo os
# caracteres de quatro bytes. Titulo e descricao de curso sao texto livre
# escrito por pessoas.
character-set-server=utf8mb4

# Collation do plano. Acompanha o charset: declarar um sem o outro deixaria a
# comparacao de texto no default da versao, que ja mudou entre releases do
# MySQL.
collation-server=utf8mb4_0900_ai_ci
